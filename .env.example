# --- LLM provider (answer generation + safety moderation) ---
# Nothing is hardcoded: pick the provider and model entirely via env vars.
# WHATIF_PROVIDER: "anthropic" (default) or "gemini"
WHATIF_PROVIDER=anthropic
WHATIF_MODEL=claude-sonnet-5
# WHATIF_PROVIDER=gemini
# WHATIF_MODEL=gemini-2.0-flash

# Moderation can use a different (usually cheaper/faster) provider/model.
# Both fall back to the answer provider/model above if unset.
WHATIF_MODERATION_PROVIDER=
WHATIF_MODERATION_MODEL=

# API keys - only the one matching your chosen provider(s) above is needed.
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# --- Image sourcing ---
# Real-photo search (Wikimedia Commons needs no key; Openverse works
# anonymously at a lower rate limit, or set a key for higher limits)
OPENVERSE_API_KEY=

# AI image-gen fallback, used only when no real photo is found.
# Leave blank to use the bundled placeholder illustration instead.
WHATIF_IMAGE_PROVIDER=openai
WHATIF_IMAGE_MODEL=gpt-image-1
WHATIF_IMAGE_API_KEY=

# --- App ---
NEXT_PUBLIC_APP_NAME="What If"
